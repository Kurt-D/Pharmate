# Client build configuration.
#
# VITE_API_BASE — absolute base URL of the backend API.
#
#   Production / pilot (`npm run build`): LEAVE UNSET. The bundle then calls the
#   API same-origin ('/api/...'), which is what the VPS Nginx + HTTPS reverse
#   proxy serves. Do not point production at a raw IP or plain HTTP.
#
#   On-device testing only (`npm run build:device`, mode=lantest): set this to a
#   dev PC's LAN address so a sideloaded debug APK can reach it, e.g.
#   VITE_API_BASE=http://192.168.1.20:3000. Put that in a gitignored
#   `.env.lantest` file — never in `.env.production`. See ANDROID_TESTING.md.

# Bot protection: must match the server's CAPTCHA_PROVIDER.
VITE_CAPTCHA_PROVIDER=turnstile
VITE_TURNSTILE_SITE_KEY=site-key-from-cloudflare
# Local development only. The client also requires Vite development mode.
VITE_DISABLE_CAPTCHA=false

# Google Identity Services Web OAuth 2.0 client ID
VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
