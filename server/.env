# Application
NODE_ENV=development
DISABLE_CAPTCHA=true
PORT=3000

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=pharmate
DB_USER=root
DB_PASS=
DB_PASSWORD=

# JWT
JWT_SECRET=default-jwt-secret-key-at-least-64-characters-long-12345678901234567890
JWT_REFRESH_SECRET=default-jwt-refresh-secret-key-at-least-64-characters-long-1234567890
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# PII Encryption Key (64 hex characters)
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# File Uploads
UPLOADS_DIR=./uploads

# Local-development-only Cloudflare Turnstile test configuration.
# Replace the secret for production; never use test credentials in production.
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
CAPTCHA_SIGNING_SECRET=c990a0cad6f1e0a934055bdb89778f47626dd881399e36f1425fafa7a3c8425ac754bfb7ccff4ac87c2c0143cb97fb7d

# Add the matching Web OAuth client ID from your own Google Cloud project to
# enable Google Sign-In. Never place a Google client secret in this file.
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=1043360422256-7qa6ub37hvesragc3srhdsbh4auso3cg.apps.googleusercontent.com

# Password recovery. The reset signing secret below was generated locally.
RESET_TOKEN_SECRET=bfa5abd38bb099aac95efe46d048a34bde0d0feb722dfc23508ee2b216f395e6f85cdf826162977d72bbe008cb8ccdf4
PASSWORD_RESET_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Fill these two values, then change PASSWORD_RESET_EMAIL_ENABLED to true.
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PharMate Security <your-address@gmail.com>"
