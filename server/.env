# Application
NODE_ENV=development
PORT=3000

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=pharmate
DB_USER=root
DB_PASS=
DB_PASSWORD=

# JWT
JWT_SECRET=default-jwt-secret-key-at-least-64-characters-long-12345678901234567890
JWT_REFRESH_SECRET=default-jwt-refresh-secret-key-at-least-64-characters-long-1234567890
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# PII Encryption Key (64 hex characters)
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# File Uploads
UPLOADS_DIR=./uploads