# Application
NODE_ENV=development
# Local development only. Server startup rejects this flag in production.
DISABLE_CAPTCHA=false
PORT=3000

# Database (MySQL 8 / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=pharmate
DB_USER=root
DB_PASS=
DB_PASSWORD=

# JWT — generate two separate long random strings
JWT_SECRET=changeme-at-least-64-chars-random
JWT_REFRESH_SECRET=changeme-different-at-least-64-chars-random
# Optional third signing key for 10-minute password-reset grants. When omitted,
# JWT_REFRESH_SECRET is used with a separate issuer, audience, and purpose claim.
PASSWORD_RESET_JWT_SECRET=changeme-third-at-least-64-chars-random
# Preferred name for the same dedicated password-reset signing key.
RESET_TOKEN_SECRET=changeme-reset-token-secret-at-least-64-chars-random
# Separate pepper used to hash short-lived caregiver pairing codes.
INVITE_CODE_PEPPER=changeme-another-at-least-64-chars-random
# Access token lifetime (e.g. 15m)
JWT_ACCESS_EXPIRES=15m
# Refresh token lifetime in days
JWT_REFRESH_EXPIRES_DAYS=30

# PII encryption key — must be exactly 32 bytes (64 hex chars)
# Generate: openssl rand -hex 32
AES_KEY=changeme-64-hex-chars-here

# Google Identity Services — Web OAuth 2.0 client ID (never a client secret)
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Bot protection: choose exactly one provider. Never silently downgrade.
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SECRET_KEY=secret-key-from-cloudflare
# Comma-separated hostnames returned by Turnstile, without scheme or port.
TURNSTILE_ALLOWED_HOSTNAMES=localhost,pharmate.example.com
# Used only by CAPTCHA_PROVIDER=self-hosted. Generate at least 64 random characters.
CAPTCHA_SIGNING_SECRET=change-me-to-a-separate-random-secret-at-least-64-characters

# Password reset email
PASSWORD_RESET_EMAIL_ENABLED=false
PASSWORD_RESET_DEV_LOG_TOKEN=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PharMate Security <your-address@gmail.com>"

# Firebase — path to service account JSON downloaded from Firebase Console
FCM_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json

# File uploads (prescription photos, stored app-private)
UPLOADS_DIR=./uploads
