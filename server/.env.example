# Application
NODE_ENV=development
PORT=3000
# Comma-separated browser origins. Local Vite origins are also allowed outside production.
CORS_ORIGINS=https://app.example.com
# Maximum JSON request size (Express-compatible value)
JSON_BODY_LIMIT=32kb

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pharmate
DB_USER=pharmate
DB_PASS=changeme

# JWT — generate two separate long random strings
JWT_SECRET=replace-with-a-random-secret-of-at-least-64-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-64-characters
# Access token lifetime (e.g. 15m)
JWT_ACCESS_EXPIRES=15m
# Refresh token lifetime in days
JWT_REFRESH_EXPIRES_DAYS=30

# PII encryption key — must be exactly 32 bytes (64 hex chars)
# Generate: openssl rand -hex 32
AES_KEY=replace-with-exactly-64-hexadecimal-characters

# Firebase — path to service account JSON downloaded from Firebase Console
FCM_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json

# File uploads (prescription photos, stored app-private)
UPLOADS_DIR=./uploads

# Read notification retention (unread notifications are never age-purged)
NOTIFICATION_RETENTION_DAYS=90

# Password reset email (disabled by default). SMTP values are required when enabled.
PASSWORD_RESET_EMAIL_ENABLED=false
PUBLIC_APP_URL=https://app.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_SENDER=no-reply@example.com
# Local-only escape hatch. Never enable outside NODE_ENV=development.
PASSWORD_RESET_DEV_LOG_TOKEN=false
# Pharmacist prescription review claim lease (1-1440 minutes; default 15)
VALIDATION_CLAIM_LEASE_MINUTES=15
