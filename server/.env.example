# Application
NODE_ENV=development
PORT=3000

# Database (MySQL 8 / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=pharmate
DB_USER=root
DB_PASS=
DB_PASSWORD=

# JWT — generate two separate long random strings
JWT_SECRET=changeme-at-least-64-chars-random
JWT_REFRESH_SECRET=changeme-different-at-least-64-chars-random
# Separate pepper used to hash short-lived caregiver pairing codes.
INVITE_CODE_PEPPER=changeme-another-at-least-64-chars-random
# Access token lifetime (e.g. 15m)
JWT_ACCESS_EXPIRES=15m
# Refresh token lifetime in days
JWT_REFRESH_EXPIRES_DAYS=30

# PII encryption key — must be exactly 32 bytes (64 hex chars)
# Generate: openssl rand -hex 32
AES_KEY=changeme-64-hex-chars-here

# Firebase — path to service account JSON downloaded from Firebase Console
FCM_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json

# File uploads (prescription photos, stored app-private)
UPLOADS_DIR=./uploads
