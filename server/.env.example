# Application
NODE_ENV=development
PORT=3000
# Comma-separated browser origins. Local Vite origins are also allowed outside production.
CORS_ORIGINS=https://app.example.com
# Maximum JSON request size (Express-compatible value)
JSON_BODY_LIMIT=32kb

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pharmate
DB_USER=pharmate
DB_PASS=changeme

# JWT — generate two separate long random strings
JWT_SECRET=replace-with-a-random-secret-of-at-least-64-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-64-characters
# Access token lifetime (e.g. 15m)
JWT_ACCESS_EXPIRES=15m
# Refresh token lifetime in days
JWT_REFRESH_EXPIRES_DAYS=30

# PII encryption key — must be exactly 32 bytes (64 hex chars)
# Generate: openssl rand -hex 32
AES_KEY=replace-with-exactly-64-hexadecimal-characters

# Firebase — path to service account JSON downloaded from Firebase Console
FCM_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json

# File uploads (prescription photos, stored app-private)
UPLOADS_DIR=./uploads
