{
  "name": "pharmate-server",
  "version": "0.1.0",
  "description": "PharMate backend — Node.js + Express + MySQL 8",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed:dev": "node src/db/seed-dev.js",
    "seed:formulary": "node src/db/seed-formulary.js",
    "import:ph-fda": "node src/db/import-ph-fda-csv.js",
    "import:drug-reference": "node src/db/import-drug-reference-json.js",
    "import:medicine-catalog": "node src/db/import-medicine-catalog-csv.js",
    "dedupe:provisional-drugs": "node src/db/dedupe-provisional-drugs.js",
    "validate:clinical-rules": "node src/db/validate-clinical-rules.js",
    "repair:invite-codes": "node src/db/repair-invite-codes.js",
    "db:test:setup": "node src/db/setup-test-db.js",
    "purge:photos": "node src/jobs/purgePhotos.js",
    "sweep:missed": "node src/jobs/sweepMissed.js",
    "push:test": "node src/jobs/testPush.js",
    "pretest": "npm run db:test:setup",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint ."
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "mysql2": "^3.24.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.6",
    "socket.io": "^4.8.3",
    "svg-captcha": "^1.4.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "eslint": "^9.30.1",
    "jest": "^29.7.0",
    "supertest": "^7.1.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.6": true
  }
}
