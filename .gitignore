node_modules
.env
**/.env
.env.*
!.env.example
!**/.env.example
.npm-cache/
.idea/
tmp/

# Local recovery data and agent-generated session exports are not application source.
/.db-backups/
/extract_session_diff.py
/session_diff_*.txt
/session_patch_*.patch
/session_patch_call_*.txt

# Runtime/test prescription uploads can contain sensitive patient data. They
# are application data, never source files, regardless of their extension.
/server/uploads/**
!/server/uploads/.gitkeep

# Local process output. Deployment platforms collect logs independently.
/server/runtime-server*.log
